            "완속"
          ]
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "exclude_stations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rework_reason": {
          "type": "string"
        }
      }
    },
    "output_schema": {
      "type": "object",
