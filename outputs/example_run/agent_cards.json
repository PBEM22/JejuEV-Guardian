  {
    "name": "weather_safety_agent",
    "display_name": "기상·안전 검증 Agent",
    "role": "대상일 기상과 교통사고 다발지역으로 후보 충전소의 안전성을 교차 검증하고, 위험 시 재탐색을 요청",
    "version": "1.0.0",
    "capabilities": [
      "weather_lookup",
      "accident_proximity_check",
      "reroute_decision"
    ],
    "input_schema": {
      "type": "object",
      "required": [
        "region",
        "date",
        "hour",
        "candidates"
      ],
      "properties": {
        "region": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "station_id",
              "station_name",
              "emd_name",
              "wait_min"
            ],
            "properties": {
              "station_id": {
                "type": "string"
              },
              "station_name": {
                "type": "string"
              },
              "emd_name": {
                "type": "string"
              },
              "wait_min": {
                "type": "number"
              },
              "parking_type": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "check_top_n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "output_schema": {
      "type": "object",
      "required": [
        "flags",
        "weather",
        "verdict"
      ],
      "properties": {
        "flags": {
          "type": "array"
        },
        "weather": {
          "type": "object"
        },
        "verdict": {
          "type": "string"
        }
      }
    },
    "data_sources": [
      {
        "dataset": "[756] 일별 기상 정보",
