# JejuEV Guardian 환경 설정 — 모두 선택 사항입니다.
# 값을 비워두면 Zero-Key 내장 엔진이 API 키/인터넷 없이 100% 동작합니다.
# 이 파일을 .env 로 복사한 뒤 필요한 값만 채우세요. (.env 는 배포본에 포함되지 않습니다)

# 추론 백엔드 강제 지정: zerokey | ollama | cloud (비우면 자동 판별)
JEJU_ENGINE=

# 제주데이터허브 Open API (open.jejudatahub.net 에서 발급)
JEJU_HUB_API_KEY=
JEJU_USE_LIVE_API=0
# JEJU_HUB_BASE=https://open.jejudatahub.net/api/proxy

# 로컬 경량 LLM (GTX 1060 3GB VRAM → 3B 4-bit 권장)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT=25

# 클라우드 LLM API (OpenAI/Gemini 호환)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 기상 실시간 조회 (0 = 완전 오프라인, 내장 실측 기상만 사용)
JEJU_LIVE_WEATHER=1

# 산출물 저장 위치 (기본: ./outputs)
# JEJU_OUTPUT_DIR=
